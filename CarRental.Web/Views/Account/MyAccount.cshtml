@model CarRental.Web.ViewModels.AccountViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "My Account";
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var activeRentals = Model.RentalHistory.Where(r => r.Status == "Active").ToList();
}

<h1 class="mb-4">My Account</h1>

<!-- Account Info Card -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm text-center">
            <div class="card-body">
                <div style="font-size: 3rem; color: var(--rr-primary);">&#128100;</div>
                <h4 class="mt-2">@Model.Username</h4>
                <span class="badge bg-primary">@Model.Role</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm text-center h-100">
            <div class="card-body d-flex flex-column justify-content-center">
                <p class="text-muted mb-1">Account Balance</p>
                <h2 style="color: var(--rr-accent);">€@Model.AccountBalance.ToString("F2")</h2>
                <p class="text-muted small mb-0">Available for future bookings</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm text-center h-100">
            <div class="card-body d-flex flex-column justify-content-center">
                <p class="text-muted mb-1">Active Bookings</p>
                <h2 style="color: var(--rr-primary);">@activeRentals.Count</h2>
                <p class="text-muted small mb-0">
                    Total spent: €@activeRentals.Sum(r => r.TotalPrice).ToString("F2")
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Rental History Section -->
<div class="card shadow">
    <div class="card-header card-header-rr">
        <h5 class="mb-0">Rental History</h5>
    </div>

    @if (!Model.RentalHistory.Any())
    {
        <div class="card-body">
            <div class="alert alert-info mb-0">
                <h5 class="alert-heading">No rentals yet!</h5>
                <p class="mb-0">You haven't rented any cars yet. <a asp-controller="Car" asp-action="Index" class="alert-link">Browse available cars</a> to get started.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover table-header-rr mb-0">
                    <thead>
                        <tr>
                            <th>Booking #</th>
                            <th>Car</th>
                            <th>License Plate</th>
                            <th>Location</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Duration</th>
                            <th>Price/Day</th>
                            <th>Total Cost</th>
                            <th>Booked On</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rental in Model.RentalHistory)
                        {
                            var duration = (rental.EndDate - rental.StartDate).Days;
                            bool isCanceled = rental.Status == "Canceled" || rental.Status == "CanceledByAdmin";
                            bool isCurrentlyActive = !isCanceled && rental.StartDate <= DateTime.Today && rental.EndDate >= DateTime.Today;
                            bool isFuture = !isCanceled && rental.StartDate > DateTime.Today;
                            bool isPast = !isCanceled && rental.EndDate < DateTime.Today;
                            bool isCarDeleted = rental.Car?.IsDeleted == true;
                            int daysUntilStart = isFuture ? (rental.StartDate - DateTime.Today).Days : 0;
                            bool canCancel = (isFuture || isCurrentlyActive) && rental.Status == "Active";

                            <tr class="@(isCanceled ? "table-light" : "")">
                                <td><strong>#@rental.Id</strong></td>
                                <td>
                                    @if (isCarDeleted)
                                    {
                                        <span class="text-muted">@rental.Car?.Brand @rental.Car?.Model <em>(deleted)</em></span>
                                    }
                                    else
                                    {
                                        <a asp-controller="Car" asp-action="Details" asp-route-id="@rental.CarId">
                                            @rental.Car?.Brand @rental.Car?.Model
                                        </a>
                                    }
                                </td>
                                <td><code>@(rental.Car?.LicensePlate ?? "—")</code></td>
                                <td>@(rental.Car?.Location ?? "—")</td>
                                <td>@rental.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@rental.EndDate.ToString("dd MMM yyyy")</td>
                                <td>@duration day(s)</td>
                                <td>€@(rental.Car?.PricePerDay.ToString("F2") ?? "—")</td>
                                <td class="fw-bold">€@rental.TotalPrice.ToString("F2")</td>
                                <td class="text-muted small">@rental.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    @if (rental.Status == "CanceledByAdmin")
                                    {
                                        <span class="badge bg-danger" title="Canceled by admin — 120% refunded">Canceled (Admin)</span>
                                    }
                                    else if (rental.Status == "Canceled")
                                    {
                                        <span class="badge bg-warning text-dark">Canceled</span>
                                    }
                                    else if (isCurrentlyActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if (isFuture)
                                    {
                                        <span class="badge bg-primary">Upcoming</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Completed</span>
                                    }
                                </td>
                                <td>
                                    @if (canCancel)
                                    {
                                        string refundInfo;
                                        if (isFuture)
                                        {
                                            refundInfo = daysUntilStart >= 3
                                                ? "Full refund (100%) will be credited to your balance."
                                                : "Only 85% refund (less than 3 days notice) will be credited.";
                                        }
                                        else
                                        {
                                            refundInfo = "A pro-rated refund for the remaining unused days will be credited to your balance.";
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-cancel-url="/Car/CancelBooking/@rental.Id"
                                                data-cancel-title="Cancel Booking #@rental.Id"
                                                data-cancel-msg="@refundInfo"
                                                onclick="showCancelModal(this)">
                                            Cancel
                                            @if (isFuture && daysUntilStart < 3)
                                            {
                                                <small>(85%)</small>
                                            }
                                            else if (isCurrentlyActive)
                                            {
                                                <small>(pro-rated)</small>
                                            }
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="card text-center shadow-sm">
                        <div class="card-body">
                            <h3 style="color: var(--rr-primary);">@activeRentals.Count()</h3>
                            <p class="text-muted mb-0">Active/Completed Rentals</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-center shadow-sm">
                        <div class="card-body">
                            <h3 class="text-success">€@activeRentals.Sum(r => r.TotalPrice).ToString("F2")</h3>
                            <p class="text-muted mb-0">Total Spent</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-center shadow-sm">
                        <div class="card-body">
                            <h3 style="color: var(--rr-accent);">@activeRentals.Sum(r => (r.EndDate - r.StartDate).Days)</h3>
                            <p class="text-muted mb-0">Total Days Rented</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Cancel Confirmation Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="cancelModalLabel">Cancel Booking</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <div style="font-size: 3rem; color: #dc3545;">&#9888;</div>
                </div>
                <p class="text-center fs-5" id="cancelModalMessage">Are you sure you want to cancel this booking?</p>
                <p class="text-center text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep Booking</button>
                <button type="button" class="btn btn-danger" id="cancelModalConfirmBtn" onclick="confirmCancel()">
                    Yes, Cancel Booking
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var csrfToken = '@token';
        var pendingCancelUrl = '';

        function showCancelModal(btn) {
            var title = btn.getAttribute('data-cancel-title');
            var msg = btn.getAttribute('data-cancel-msg');
            pendingCancelUrl = btn.getAttribute('data-cancel-url');

            document.getElementById('cancelModalLabel').textContent = title;
            document.getElementById('cancelModalMessage').textContent = msg;
            var modal = new bootstrap.Modal(document.getElementById('cancelModal'));
            modal.show();
        }

        function confirmCancel() {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = pendingCancelUrl;
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = '__RequestVerificationToken';
            input.value = csrfToken;
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }
    </script>
}
