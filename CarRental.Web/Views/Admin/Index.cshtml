@model IEnumerable<Car>
@{
    ViewData["Title"] = "Admin Dashboard";
    decimal grossRevenue = ViewBag.GrossRevenue ?? 0m;
    decimal totalExpenses = ViewBag.TotalExpenses ?? 0m;
    decimal totalRefunds = ViewBag.TotalRefunds ?? 0m;
    decimal welcomeBonuses = ViewBag.WelcomeBonuses ?? 0m;
    decimal netRevenue = ViewBag.NetRevenue ?? 0m;
    int totalBookings = ViewBag.TotalBookings ?? 0;
    int activeBookings = ViewBag.ActiveBookings ?? 0;
    int canceledBookings = ViewBag.CanceledBookings ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Admin Dashboard — Manage Cars</h1>
    <a asp-action="Create" class="btn btn-success btn-lg">+ Add New Car</a>
</div>

<!-- Revenue Dashboard -->
<div class="row mb-4 g-3">
    <div class="col-md-3">
        <div class="card shadow text-center" style="border-left: 4px solid var(--rr-accent);">
            <div class="card-body">
                <small class="text-muted text-uppercase fw-bold">Gross Revenue</small>
                <h3 class="mb-0 mt-1" style="color: var(--rr-accent);">€@grossRevenue.ToString("F2")</h3>
                <small class="text-muted">@totalBookings total booking(s)</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow text-center" style="border-left: 4px solid #dc3545;">
            <div class="card-body">
                <small class="text-muted text-uppercase fw-bold">Expenses</small>
                <h3 class="mb-0 mt-1 text-danger">€@totalExpenses.ToString("F2")</h3>
                <small class="text-muted">Refunds: €@totalRefunds.ToString("F2") | Bonuses: €@welcomeBonuses.ToString("F2")</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow text-center" style="border-left: 4px solid @(netRevenue >= 0 ? "#198754" : "#dc3545");">
            <div class="card-body">
                <small class="text-muted text-uppercase fw-bold">Net Revenue</small>
                <h3 class="mb-0 mt-1" style="color: @(netRevenue >= 0 ? "#198754" : "#dc3545");">€@netRevenue.ToString("F2")</h3>
                <small class="text-muted">Gross − Expenses</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow text-center" style="border-left: 4px solid var(--rr-primary);">
            <div class="card-body">
                <small class="text-muted text-uppercase fw-bold">Bookings</small>
                <h3 class="mb-0 mt-1" style="color: var(--rr-primary);">@activeBookings Active</h3>
                <small class="text-muted">@canceledBookings canceled</small>
            </div>
        </div>
    </div>
</div>

<div class="card shadow">
    <div class="card-body p-0">
        <table class="table table-striped table-hover table-header-rr mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Brand</th>
                    <th>Model</th>
                    <th>Location</th>
                    <th>Plate</th>
                    <th>Seats</th>
                    <th>Price/Day</th>
                    <th class="text-center" style="width: 280px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var car in Model)
                {
                    <tr>
                        <td>@car.Id</td>
                        <td><strong>@car.Brand</strong></td>
                        <td>@car.Model</td>
                        <td>@car.Location</td>
                        <td><code>@car.LicensePlate</code></td>
                        <td>@car.Seats</td>
                        <td>€@car.PricePerDay</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-controller="Car" asp-action="Details" asp-route-id="@car.Id" class="btn btn-sm btn-info">View</a>
                            <a asp-action="Delete" asp-route-id="@car.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3 text-muted">
    Total Cars: <strong>@Model.Count()</strong>
</div>
