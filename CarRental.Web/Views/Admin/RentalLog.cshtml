@model IEnumerable<RentalBooking>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Rental Log";
    string currentPeriod = ViewBag.CurrentPeriod ?? "all";
    var unavailPeriods = ViewBag.UnavailabilityPeriods as List<UnavailabilityPeriod> ?? new List<UnavailabilityPeriod>();
    var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Rental Log</h1>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="RentalLog" method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label for="period" class="form-label fw-bold">Filter by Period</label>
                <select name="period" id="period" class="form-select">
                    <option value="all" selected="@(currentPeriod == "all")">All Time</option>
                    <option value="week" selected="@(currentPeriod == "week")">Last Week</option>
                    <option value="month" selected="@(currentPeriod == "month")">Last Month</option>
                    <option value="year" selected="@(currentPeriod == "year")">Last Year</option>
                </select>
            </div>
            <div class="col-md-6">
                <button type="submit" class="btn btn-primary">Apply Filter</button>
                <a asp-action="RentalLog" class="btn btn-outline-secondary ms-2">Reset</a>
            </div>
        </form>
    </div>
</div>

<h4 class="mb-3">Bookings</h4>
@if (!Model.Any())
{
    <div class="alert alert-info">No rental bookings found for the selected period.</div>
}
else
{
    <div class="card shadow mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover table-header-rr mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Car</th>
                            <th>Plate</th>
                            <th>Location</th>
                            <th>Client</th>
                            <th>Rental Period</th>
                            <th>Days</th>
                            <th>Cost</th>
                            <th>Booked On</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rental in Model)
                        {
                            var duration = (rental.EndDate - rental.StartDate).Days;
                            bool isCanceled = rental.Status != "Active";
                            bool isCarDeleted = rental.Car?.IsDeleted == true;
                            bool isUpcoming = !isCanceled && rental.StartDate > DateTime.Today;

                            <tr class="@(isCanceled ? "table-light" : "")">
                                <td><strong>#@rental.Id</strong></td>
                                <td>
                                    @if (isCarDeleted)
                                    {
                                        <span class="text-muted">@rental.Car?.Brand @rental.Car?.Model <em>(deleted)</em></span>
                                    }
                                    else
                                    {
                                        <a asp-controller="Car" asp-action="Details" asp-route-id="@rental.CarId">
                                            @rental.Car?.Brand @rental.Car?.Model
                                        </a>
                                    }
                                </td>
                                <td><code>@(rental.Car?.LicensePlate ?? "—")</code></td>
                                <td>@(rental.Car?.Location ?? "—")</td>
                                <td><span class="badge" style="background: var(--rr-primary-dark);">@(rental.User?.Username ?? "Unknown")</span></td>
                                <td>@rental.StartDate.ToString("dd MMM yyyy") — @rental.EndDate.ToString("dd MMM yyyy")</td>
                                <td>@duration</td>
                                <td class="fw-bold">€@rental.TotalPrice.ToString("F2")</td>
                                <td class="text-muted small">@rental.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    @if (rental.Status == "CanceledByAdmin")
                                    {
                                        <span class="badge bg-danger">Canceled (Admin)</span>
                                    }
                                    else if (rental.Status == "Canceled")
                                    {
                                        <span class="badge bg-warning text-dark">Canceled (Client)</span>
                                    }
                                    else if (rental.EndDate < DateTime.Today)
                                    {
                                        <span class="badge bg-secondary">Completed</span>
                                    }
                                    else if (rental.StartDate <= DateTime.Today)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Upcoming</span>
                                    }
                                </td>
                                <td>
                                    @if (isUpcoming)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-cancel-url="/Admin/CancelBooking/@rental.Id"
                                                data-cancel-title="Cancel Booking #@rental.Id"
                                                data-cancel-client="@(rental.User?.Username ?? "Unknown")"
                                                onclick="showAdminCancelModal(this)">
                                            Cancel (120%)
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<h4 class="mb-3">Unavailability Periods</h4>
@if (!unavailPeriods.Any())
{
    <div class="alert alert-info">No unavailability periods found for the selected period.</div>
}
else
{
    <div class="card shadow mb-4">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-warning">
                    <tr>
                        <th>#</th>
                        <th>Car</th>
                        <th>Plate</th>
                        <th>Period</th>
                        <th>Duration</th>
                        <th>Reason</th>
                        <th>Set On</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var period in unavailPeriods)
                    {
                        var duration = (period.EndDate - period.StartDate).Days;
                        bool isCarDeleted = period.Car?.IsDeleted == true;

                        <tr>
                            <td><strong>#@period.Id</strong></td>
                            <td>
                                @if (isCarDeleted)
                                {
                                    <span class="text-muted">@period.Car?.Brand @period.Car?.Model <em>(deleted)</em></span>
                                }
                                else
                                {
                                    <a asp-controller="Car" asp-action="Details" asp-route-id="@period.CarId">
                                        @period.Car?.Brand @period.Car?.Model
                                    </a>
                                }
                            </td>
                            <td><code>@(period.Car?.LicensePlate ?? "—")</code></td>
                            <td>@period.StartDate.ToString("dd MMM yyyy") — @period.EndDate.ToString("dd MMM yyyy")</td>
                            <td>@duration day(s)</td>
                            <td>@(period.Reason ?? "—")</td>
                            <td class="text-muted small">@period.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h3 style="color: var(--rr-primary);">@Model.Count()</h3>
                <p class="text-muted mb-0">Total Bookings</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h3 class="text-success">€@Model.Where(r => r.Status == "Active").Sum(r => r.TotalPrice).ToString("F2")</h3>
                <p class="text-muted mb-0">Revenue (Active)</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h3 style="color: var(--rr-accent);">@Model.Where(r => r.Status == "Active").Select(r => r.UserId).Distinct().Count()</h3>
                <p class="text-muted mb-0">Active Clients</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h3 class="text-danger">@Model.Count(r => r.Status != "Active")</h3>
                <p class="text-muted mb-0">Canceled Bookings</p>
            </div>
        </div>
    </div>
</div>

<!-- Admin Cancel Confirmation Modal -->
<div class="modal fade" id="adminCancelModal" tabindex="-1" aria-labelledby="adminCancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="adminCancelModalLabel">Admin Cancel Booking</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <div style="font-size: 3rem; color: #dc3545;">&#9888;</div>
                </div>
                <p class="text-center fs-5">Are you sure you want to cancel this booking?</p>
                <p class="text-center" id="adminCancelClientInfo"></p>
                <div class="alert alert-warning text-center mb-0">
                    <strong>120% refund</strong> will be credited to the client's account balance.
                </div>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep Booking</button>
                <button type="button" class="btn btn-danger" id="adminCancelConfirmBtn" onclick="confirmAdminCancel()">
                    Yes, Cancel & Refund 120%
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var adminCsrfToken = '@csrfToken';
        var pendingAdminCancelUrl = '';

        function showAdminCancelModal(btn) {
            var title = btn.getAttribute('data-cancel-title');
            var client = btn.getAttribute('data-cancel-client');
            pendingAdminCancelUrl = btn.getAttribute('data-cancel-url');

            document.getElementById('adminCancelModalLabel').textContent = title;
            document.getElementById('adminCancelClientInfo').innerHTML =
                'Client: <strong>' + client + '</strong>';
            var modal = new bootstrap.Modal(document.getElementById('adminCancelModal'));
            modal.show();
        }

        function confirmAdminCancel() {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = pendingAdminCancelUrl;
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = '__RequestVerificationToken';
            input.value = adminCsrfToken;
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }
    </script>
}
