@model Car
@{
    ViewData["Title"] = $"{Model.Brand} {Model.Model} — Details";
    bool isAdmin = ViewBag.IsAdmin ?? false;
    bool isAuthenticated = ViewBag.IsAuthenticated ?? false;
    var locations = ViewBag.Locations as List<string> ?? new List<string>();
    var carsForLocation = ViewBag.CarsForLocation as List<Car> ?? new List<Car>();
    var selectedLocation = ViewBag.SelectedLocation as string ?? Model.Location;
    var selectedPlate = ViewBag.SelectedPlate as string ?? Model.LicensePlate;
    var searchStart = ViewBag.SearchStart as string;
    var searchEnd = ViewBag.SearchEnd as string;
    var cartCount = (int)(ViewBag.CartCount ?? 0);
}

<link rel="stylesheet" href="~/css/rental-calendar.css" asp-append-version="true" />

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Browse Cars</a></li>
        <li class="breadcrumb-item active">@Model.Brand @Model.Model</li>
    </ol>
</nav>

<div class="row">
    <div class="col-lg-5">
        <div class="card shadow">
            <!-- Wikipedia image -->
            <div class="card-img-top d-flex align-items-center justify-content-center wiki-img-detail"
                 style="height: 300px; background: var(--rr-light); overflow: hidden;"
                 data-brand="@Model.Brand" data-model="@Model.Model">
                <span style="font-size: 5rem; color: var(--rr-primary);">CAR</span>
            </div>
            <div class="card-body">
                <h2 class="card-title">@Model.Brand @Model.Model</h2>
                <hr />
                <p class="card-text">@Model.Description</p>
                <table class="table table-borderless mb-0">
                    <tr><th>Brand:</th><td>@Model.Brand</td></tr>
                    <tr><th>Model:</th><td>@Model.Model</td></tr>
                    <tr><th>Seats:</th><td>@Model.Seats</td></tr>
                    <tr>
                        <th>Price per Day:</th>
                        <td class="fs-5 fw-bold" style="color: var(--rr-accent);">€@Model.PricePerDay</td>
                    </tr>
                </table>

                @if (!string.IsNullOrEmpty(Model.Chassis) || Model.FabricationYear.HasValue || !string.IsNullOrEmpty(Model.EngineType))
                {
                    <hr />
                    <h6 class="fw-bold" style="color: var(--rr-primary);">Specifications</h6>
                    <table class="table table-sm table-borderless mb-0">
                        @if (!string.IsNullOrEmpty(Model.Chassis))
                        {
                            <tr><th style="width:40%;">Chassis:</th><td>@Model.Chassis</td></tr>
                        }
                        @if (Model.FabricationYear.HasValue)
                        {
                            <tr><th>Year:</th><td>@Model.FabricationYear</td></tr>
                        }
                        @if (!string.IsNullOrEmpty(Model.EngineType))
                        {
                            <tr><th>Engine:</th><td>@Model.EngineType</td></tr>
                        }
                        @if (Model.Horsepower.HasValue)
                        {
                            <tr><th>Power:</th><td>@Model.Horsepower HP</td></tr>
                        }
                        @if (!string.IsNullOrEmpty(Model.Transmission))
                        {
                            <tr><th>Transmission:</th><td>@Model.Transmission</td></tr>
                        }
                        @if (!string.IsNullOrEmpty(Model.FuelConsumption))
                        {
                            <tr><th>Fuel:</th><td>@Model.FuelConsumption</td></tr>
                        }
                    </table>
                }
            </div>
        </div>

        @if (cartCount > 0)
        {
            <div class="mt-3">
                <a asp-action="Cart" class="btn btn-accent w-100">View Cart (@cartCount)</a>
            </div>
        }
    </div>

    <div class="col-lg-7">
        <!-- City / License Plate selection -->
        <div class="card shadow mb-3">
            <div class="card-header card-header-rr">
                <h5 class="mb-0">Select Location & Vehicle</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="citySelect" class="form-label fw-bold">City</label>
                        <select id="citySelect" class="form-select">
                            @foreach (var loc in locations)
                            {
                                <option value="@loc" selected="@(loc == selectedLocation)">@loc</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="plateSelect" class="form-label fw-bold">License Plate</label>
                        <select id="plateSelect" class="form-select">
                            @foreach (var c in carsForLocation)
                            {
                                <option value="@c.LicensePlate" data-car-id="@c.Id"
                                        selected="@(c.LicensePlate == selectedPlate)">
                                    @c.LicensePlate (@c.Location)
                                </option>
                            }
                        </select>
                    </div>
                </div>
                <p class="text-muted small mt-2 mb-0">
                    Currently viewing: <strong id="currentPlateLabel">@selectedPlate</strong> in <strong id="currentCityLabel">@selectedLocation</strong>
                </p>
            </div>
        </div>

        <!-- Calendar -->
        <div class="card shadow mb-3">
            <div class="card-header card-header-rr">
                <h4 class="mb-0">
                    @(isAdmin ? "Rental Log Calendar" : "Availability Calendar")
                </h4>
            </div>
            <div class="card-body p-0">
                <div id="rental-calendar" class="rental-calendar"></div>
            </div>
        </div>

        @if (isAdmin)
        {
            <div class="card shadow mb-3">
                <div class="card-header card-header-accent">
                    <h5 class="mb-0">Set Unavailability Period</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">
                        Mark this car as unavailable for a period (e.g. maintenance, repairs).
                        <strong>Any overlapping client bookings will be automatically canceled with 120% refund.</strong>
                    </p>
                    <form asp-controller="Admin" asp-action="SetUnavailable" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="carId" id="unavailCarId" value="@Model.Id" />
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="unavailStart" class="form-label fw-bold">Start Date</label>
                                <input type="date" name="startDate" id="unavailStart" class="form-control"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="unavailEnd" class="form-label fw-bold">End Date</label>
                                <input type="date" name="endDate" id="unavailEnd" class="form-control"
                                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                                       value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="reason" class="form-label fw-bold">Reason</label>
                                <input type="text" name="reason" id="reason" class="form-control"
                                       placeholder="e.g. Maintenance" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-warning">Mark Unavailable</button>
                    </form>
                </div>
            </div>
        }
        else if (!isAuthenticated)
        {
            <div class="card shadow">
                <div class="card-body text-center">
                    <div class="alert alert-info mb-0">
                        Please <a asp-controller="Account" asp-action="Login" class="fw-bold">log in</a>
                        or <a asp-controller="Account" asp-action="Register" class="fw-bold">sign up</a>
                        to rent this car.
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Add to Cart</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted small">
                        Click two dates on the calendar to select your rental period, or enter dates manually.
                        <span class="text-danger">Red/pink days</span> are already booked.
                        <span style="color: #888;">Grey days</span> are unavailable.
                    </p>
                    <form asp-action="AddToCart" method="post" id="rent-form">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>
                        <input type="hidden" name="CarId" id="rentCarId" value="@Model.Id" />
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="StartDate" class="form-label fw-bold">Start Date</label>
                                <input type="date" name="StartDate" id="StartDate" class="form-control"
                                       value="@(searchStart ?? DateTime.Today.ToString("yyyy-MM-dd"))"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="EndDate" class="form-label fw-bold">End Date</label>
                                <input type="date" name="EndDate" id="EndDate" class="form-control"
                                       value="@(searchEnd ?? DateTime.Today.AddDays(1).ToString("yyyy-MM-dd"))"
                                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <p class="text-muted small mb-0">
                                Base price: <strong>€@Model.PricePerDay</strong>/day (discounts apply for 4+ days)
                            </p>
                            <button type="submit" class="btn btn-success btn-lg">Add to Cart</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/rental-calendar.js" asp-append-version="true"></script>
    <script>
        var currentCarId = @Model.Id;
        var currentBrand = '@Model.Brand';
        var currentModel = '@Model.Model';
        var bookingsUrl = '@Url.Action("GetBookings", "Car")';
        var carsForLocationUrl = '@Url.Action("GetCarsForLocation", "Car")';
        var calendarMode = '@(isAdmin ? "admin" : "client")';

        function initCalendar(carId) {
            document.getElementById('rental-calendar').innerHTML = '';
            RentalCalendar.init({
                containerId: 'rental-calendar',
                carId: carId,
                mode: calendarMode,
                bookingsUrl: bookingsUrl,
                onDateRangeSelected: function (start, end) {
                    var startInput = document.getElementById('StartDate');
                    var endInput = document.getElementById('EndDate');
                    if (startInput && endInput) {
                        startInput.value = start;
                        endInput.value = end;
                    }
                    var unavailStart = document.getElementById('unavailStart');
                    var unavailEnd = document.getElementById('unavailEnd');
                    if (unavailStart && unavailEnd) {
                        unavailStart.value = start;
                        unavailEnd.value = end;
                    }
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Load Wikipedia image
            fetch('/Car/GetWikiImage?brand=' + encodeURIComponent(currentBrand) + '&model=' + encodeURIComponent(currentModel))
                .then(r => r.json())
                .then(data => {
                    if (data.imageUrl) {
                        var container = document.querySelector('.wiki-img-detail');
                        if (container) {
                            container.innerHTML = '<img src="' + data.imageUrl + '" alt="' + currentBrand + ' ' + currentModel + '" style="width:100%;height:100%;object-fit:cover;" />';
                        }
                    }
                }).catch(() => {});

            // Init calendar
            initCalendar(currentCarId);

            // City dropdown change
            document.getElementById('citySelect').addEventListener('change', function () {
                var city = this.value;
                document.getElementById('currentCityLabel').textContent = city;
                fetch(carsForLocationUrl + '?brand=' + encodeURIComponent(currentBrand) + '&model=' + encodeURIComponent(currentModel) + '&location=' + encodeURIComponent(city))
                    .then(r => r.json())
                    .then(data => {
                        var plateSelect = document.getElementById('plateSelect');
                        plateSelect.innerHTML = '';
                        data.forEach(function (car) {
                            var opt = document.createElement('option');
                            opt.value = car.licensePlate;
                            opt.setAttribute('data-car-id', car.id);
                            opt.textContent = car.licensePlate + ' (' + city + ')';
                            plateSelect.appendChild(opt);
                        });
                        if (data.length > 0) {
                            plateSelect.dispatchEvent(new Event('change'));
                        }
                    });
            });

            // Plate dropdown change
            document.getElementById('plateSelect').addEventListener('change', function () {
                var selected = this.options[this.selectedIndex];
                if (selected) {
                    var carId = parseInt(selected.getAttribute('data-car-id'));
                    currentCarId = carId;
                    document.getElementById('currentPlateLabel').textContent = selected.value;
                    // Update hidden fields
                    var rentCarId = document.getElementById('rentCarId');
                    if (rentCarId) rentCarId.value = carId;
                    var unavailCarId = document.getElementById('unavailCarId');
                    if (unavailCarId) unavailCarId.value = carId;
                    // Reload calendar
                    initCalendar(carId);
                }
            });
        });
    </script>
}
