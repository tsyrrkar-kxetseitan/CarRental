@model RentalBooking
@{
    ViewData["Title"] = "Booking Confirmed";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow text-center">
            <div class="card-header bg-success text-white">
                <h3 class="mb-0">Booking Confirmed!</h3>
            </div>
            <div class="card-body p-4">
                <p class="fs-5">Thank you for your rental booking.</p>

                <table class="table table-borderless text-start">
                    <tr><th>Booking ID:</th><td>#@Model.Id</td></tr>
                    <tr><th>Car:</th><td>@Model.Car?.Brand @Model.Car?.Model</td></tr>
                    <tr><th>Start Date:</th><td>@Model.StartDate.ToString("dd MMM yyyy")</td></tr>
                    <tr><th>End Date:</th><td>@Model.EndDate.ToString("dd MMM yyyy")</td></tr>
                    <tr><th>Duration:</th><td>@((Model.EndDate - Model.StartDate).Days) day(s)</td></tr>
                    <tr><th>Total Price:</th><td class="fs-4 fw-bold text-success">€@Model.TotalPrice.ToString("F2")</td></tr>
                </table>
            </div>
            <div class="card-footer">
                <a asp-controller="Car" asp-action="Index" class="btn btn-primary">Back to Car Listing</a>
            </div>
        </div>
    </div>
</div>
